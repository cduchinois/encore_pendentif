{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gemma ID card for an unrecognized track",
  "type": "object",
  "required": ["genre", "description", "has_vocals", "confidence", "ts_start_ms"],
  "properties": {
    "genre": {"type": "string", "maxLength": 60},
    "description": {"type": "string", "maxLength": 240},
    "has_vocals": {"type": "boolean"},
    "lyrics_snippet": {"type": "string", "maxLength": 200},
    "bpm": {"type": ["number", "null"], "description": "from DSP (librosa), injected, not guessed by the model"},
    "key": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ts_start_ms": {"type": "integer"},
    "clip_ref": {"type": "string", "description": "path of the saved 20 s clip"}
  },
  "additionalProperties": false
}
